# Example snippet for an unprivileged LXC's config
# (Proxmox: /etc/pve/lxc/<CTID>.conf)
#
# Replace <RENDER_GID> with the actual group ID of `render` on your host (`getent group render`)
# Replace <CTID> only relevant if referencing elsewhere — not needed in this file itself.

lxc.cgroup2.devices.allow: c 226:0 rwm
lxc.cgroup2.devices.allow: c 226:128 rwm
lxc.mount.entry: /dev/dri dev/dri none bind,optional,create=dir
lxc.idmap: u 0 100000 65536
lxc.idmap: g 0 100000 <RENDER_GID>
lxc.idmap: g <RENDER_GID> <RENDER_GID> 1
lxc.idmap: g <RENDER_GID_PLUS_1> 100 65436
